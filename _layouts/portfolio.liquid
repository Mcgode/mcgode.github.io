---
layout: default
---

<div class="home">
    {%- if page.title -%}
        <h1 class="page-heading">{{ page.title }}</h1>
    {%- endif -%}

    {{ content }}

    {%- if site.portfolio.size > 0 -%}

        {% assign portfolio = site.portfolio | portfolio_sorted %}

        {%- comment -%}
            Walk the portfolio in chronological order. Major projects always get
            their own full-width row. Minor projects (or anything without an
            "importance") are batched: a run of consecutive minor projects -
            however long - is rendered together as one row, so pairing follows
            actual chronology instead of being forced.
        {%- endcomment -%}

        <div id="portfolioContainer" class="container mt-4">

            {% assign groupStart = -1 %}

            {% for entry in portfolio %}

                {% if entry.importance == "major" %}

                    {% if groupStart >= 0 %}
                        {% assign groupEnd = forloop.index0 | minus: 1 %}
                        {% include portfolio-minor-group.liquid groupStart=groupStart groupEnd=groupEnd portfolio=portfolio %}
                        {% assign groupStart = -1 %}
                    {% endif %}

                    <div class="row p-0">
                        <div class="col p-0">{% assign project = entry %}{%- include portfolio-excerpt.liquid -%}</div>
                    </div>

                {% else %}

                    {% if groupStart < 0 %}
                        {% assign groupStart = forloop.index0 %}
                    {% endif %}

                {% endif %}

            {% endfor %}

            {% if groupStart >= 0 %}
                {% assign groupEnd = portfolio.size | minus: 1 %}
                {% include portfolio-minor-group.liquid groupStart=groupStart groupEnd=groupEnd portfolio=portfolio %}
            {% endif %}

        </div>

    {%- endif -%}

</div>

<script>

    const portfolioContainer = $("#portfolioContainer");

    const factor = 0.025;
    function updateFontSize() {

        const size = Math.min(700, window.innerWidth) * factor;
        portfolioContainer.css("font-size", `${size}px`);

    }
    updateFontSize();

    $(window).resize(updateFontSize);

</script>
