<figure class="figure">
  <img
    src="{{ include.src }}"
    class="figure-img img-fluid"
    {% if include.max_height %}
      style="max-height: {{ include.max_height }}px;"
    {% endif %}
    {% if include.alt %}
      alt="{{ include.alt }}"
    {% endif %}
  />
  {% if include.caption %}
    <figcaption class="figure-caption">{{ include.caption }}</figcaption>
  {% endif %}
</figure>